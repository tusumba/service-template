SERVICE_NAME=service_template
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://tusumba:tusumba@localhost:5432/tusumba
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Публичный ключ Identity в PEM, для разработки: uv run python -m tusumba_common.testing dev-keys
JWT_PUBLIC_KEY=
SERVICE_TOKEN=dev-service-token
